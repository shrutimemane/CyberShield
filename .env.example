# CyberShield environment configuration (copy to .env and adjust)
# All values are optional - sensible defaults are built in.

# Flask session secret - CHANGE THIS for anything beyond classroom use
SECRET_KEY=change-me-to-a-long-random-string

# Default admin account created on first run
CYBERSHIELD_ADMIN_USER=admin
CYBERSHIELD_ADMIN_PASSWORD=admin123

# Server
CYBERSHIELD_PORT=5000

# Live capture (optional; requires admin rights + Npcap on Windows)
# Leave CYBERSHIELD_INTERFACE empty for the default route interface
CYBERSHIELD_INTERFACE=
CYBERSHIELD_PROMISCUOUS=false

# Demo attacker IP (documentation-reserved TEST-NET-2 range; safe)
CYBERSHIELD_ATTACKER_IP=203.0.113.66

# Database override (leave unset to use database/cybershield.db)
# DATABASE_URL=sqlite:///C:/path/to/cybershield.db
