
# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local databases and captured network traffic
*.db
*.sqlite
*.sqlite3
*.pcap
*.pcapng

# Allow the safe sample PCAP used in the README
!samples/demo_portscan.pcap

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Python test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node dependencies and build output
node_modules/
dist/
build/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Generated reports - keep the folder, not personal report data
data/reports/*
!data/reports/.gitkeep

# Local PCAP uploads - keep the folder, not uploaded captures
data/pcaps/*
!data/pcaps/.gitkeep

# SQLite database and temporary journal files
database/*.db
database/*.db-*
database/*.sqlite
database/*.sqlite3